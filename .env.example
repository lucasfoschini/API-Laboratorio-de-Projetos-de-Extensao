NODE_ENV="development"
PORT="3333"
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/laboratorio_ativo?schema=public"
JWT_SECRET="change_me_in_production_min_32_chars"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_IN="7d"
CORS_ORIGIN="http://localhost:3000,https://seu-front.vercel.app"

# SMTP (envio de e-mail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM_NAME="Laboratório Ativo"
FRONTEND_URL="http://localhost:3000"

# Seed defaults (opcionais)
PROFESSOR_EMAIL="professor@laboratorioativo.com"
PROFESSOR_PASSWORD="Professor@123"
PROFESSOR_NAME="Professor Padrão"
ALUNO_EMAIL="aluno@laboratorioativo.com"
