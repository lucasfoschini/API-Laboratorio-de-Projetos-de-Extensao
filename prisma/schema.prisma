generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ALUNO
  PROFESSOR
}

enum ProjectCategory {
  MACRO_CAD
  METROLOGIA
  OUTRO
}

enum ProjectStatus {
  ABERTO        // aceitando membros e inscrições
  EM_ANDAMENTO  // em execução
  FINALIZADO
}

enum ProjectArea {
  CONTROLE_SISTEMAS
  SISTEMAS_MECATRONICOS
  ACIONAMENTOS_ELETRICOS
  SISTEMAS_INTELIGENTES
  ROBOTICA_INDUSTRIAL
  AUTOMACAO_MECANICA
  AUTOMACAO_ELETRICA
  ENGENHARIA_PROJETO
  MANUFATURA_DIGITAL
  PROJETO_COMPUTADOR
  SIMULACAO_COMPUTACIONAL
}

enum MemberRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationType {
  ARTICLE
  REPORT
  PRESENTATION
  THESIS
}

enum MediaType {
  IMAGE
  VIDEO
  ARTICLE_LINK
  DOCUMENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        Role
  department  String?
  institution String?
  avatar            String?
  bio               String?
  phone             String?
  linkedin          String?
  github            String?
  website           String?
  resetToken        String?  @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime @default(now())

  ownedProjects    Project[]       @relation("ProjectOwner")
  memberProjects   Project[]       @relation("ProjectMembers")
  memberRequests   MemberRequest[]
  subscriptions    Subscription[]
  activities       Activity[]      @relation("ActivityResponsibles")
  posts            Post[]
  publications     Publication[]   @relation("PublicationAuthors")
  createdPubs      Publication[]   @relation("PublicationCreator")
  notifications    Notification[]
  passwordResetTokens PasswordResetToken[]
}

model Project {
  id                  String        @id @default(uuid())
  title               String
  description         String
  area                ProjectArea   @default(CONTROLE_SISTEMAS)
  areas               String[]      @default([])
  category            ProjectCategory
  categoryText        String?       // categoria livre (texto)
  status              ProjectStatus @default(ABERTO)
  vacancies           Int           @default(5)
  tags                String[]      @default([])
  startDate           DateTime?
  endDate             DateTime?
  applicationDeadline DateTime?
  coverImage          String?       // URL da imagem de capa
  tempo               String
  custo               Float         @default(0)
  escopo              String
  contactEmail        String?       // e-mail de contato público do projeto
  contactInfo         String?       // informações adicionais de contato
  createdAt           DateTime      @default(now())

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  members        User[]          @relation("ProjectMembers")
  memberRequests MemberRequest[]
  subscriptions  Subscription[]
  activities     Activity[]
  publications   Publication[]
  posts          Post[]
  notifications  Notification[]
}

// ─── Solicitação de entrada no grupo ─────────────────────────────────────────
model MemberRequest {
  id        String              @id @default(uuid())
  message   String
  status    MemberRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())

  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, status])
  @@index([userId])
}

// ─── Inscrição para acompanhar atualizações ───────────────────────────────────
model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

// ─── Postagens / Atualizações do projeto ─────────────────────────────────────
model Post {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  authorId  String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  media Media[]

  @@index([projectId])
  @@index([authorId])
}

// ─── Mídia anexada a posts ────────────────────────────────────────────────────
model Media {
  id        String    @id @default(uuid())
  type      MediaType
  url       String
  title     String?
  caption   String?
  createdAt DateTime  @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// ─── Publicações acadêmicas ───────────────────────────────────────────────────
model Publication {
  id         String          @id @default(uuid())
  title      String
  abstract   String
  content    String?         @db.Text // texto longo opcional
  type       PublicationType @default(ARTICLE)
  year       Int
  journal    String?
  doi        String?
  zenodoLink String?
  tags       String[]        @default([])
  images     String[]        @default([])  // URLs de imagens
  references String[]        @default([])  // referências bibliográficas
  approved          Boolean         @default(false)
  revisionRequested Boolean         @default(false)
  createdAt  DateTime        @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("PublicationCreator", fields: [userId], references: [id], onDelete: SetNull)

  authors   User[]  @relation("PublicationAuthors")

  @@index([projectId])
  @@index([approved])
  @@index([approved, projectId])
  @@index([userId])
}


// ─── Atividades ──────────────────────────────────────────────────────────────
model Activity {
  id          String   @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())

  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  responsibles User[]   @relation("ActivityResponsibles")

  @@index([projectId])
}

// ─── Notificações ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  type      String   // ex: MEMBER_LEFT, MEMBER_REMOVED, REQUEST_ACCEPTED
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
